# =============================================================================
# SimsBuddy Staging Environment - Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env
# =============================================================================

# =============================================================================
# 🗄️ DATABASE CONFIGURATION
# =============================================================================
# Railway PostgreSQL database connection string
# Format: postgresql://username:password@host:port/database
# Get this from: Railway dashboard → your project → PostgreSQL → Connect
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.railway.app:5432/railway

# =============================================================================
# 🔐 AUTHENTICATION & SECURITY
# =============================================================================
# Secret key for JWT token generation (change this to a random string)
# Generate one: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Shared secret for backend-to-voice-agent communication
# Generate one: openssl rand -hex 32
VOICE_AGENT_SHARED_SECRET=2c99e4f256738c811fda12c7702f6886505d8435d6a65ee21e17022b1be208c0

# =============================================================================
# 🎤 VOICE AGENT SERVICES (LiveKit WebRTC)
# =============================================================================
# LiveKit cloud configuration for real-time voice communication
# Get these from: https://cloud.livekit.io/ → Project Settings → Keys
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET

# Voice agent service URL (for backend communication)
# Keep as-is for Docker: http://localhost:8000
LIVEKIT_SERVICE_URL=http://localhost:8000

# Redis connection for Celery task queue
# Keep as-is for Docker: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# 🤖 AI SERVICE API KEYS (Required)
# =============================================================================

# Groq - LLM for AI conversations
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# AssemblyAI - Speech-to-Text (STT)
# Get from: https://www.assemblyai.com/app/account
ASSEMBLY_API_KEY=YOUR_KEY_HERE

# Inworld - Text-to-Speech (TTS)
# Get from: https://studio.inworld.ai/workspaces
INWORLD_API_KEY=YOUR_KEY_HERE

# OpenAI - Additional AI features
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-YOUR_KEY_HERE

# =============================================================================
# 🤖 AI SERVICE API KEYS (Optional - Leave blank if not using)
# =============================================================================

# Deepgram - Alternative STT provider
DEEPGRAM_API_KEY=

# ElevenLabs - Alternative TTS provider
ELEVEN_API_KEY=

# DeepInfra - Alternative LLM provider
DEEPINFRA_API_KEY=

# Speechify - Alternative TTS provider
SPEECHIFY_API_KEY=

# Together AI - Alternative LLM provider
TOGETHER_API_KEY=

# Rime - Alternative TTS provider
RIME_API_KEY=

# Riva - Alternative AI provider
RIVA_API_KEY=

# =============================================================================
# ☁️ CLOUD SERVICE CREDENTIALS (Optional)
# =============================================================================

# Google Cloud Platform
GOOGLE_PROJECT_ID=
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_PRIVATE_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_X509_CERT_URL=

# AWS Credentials
AWS_SECRET_ACCESS_KEY=
AWS_ACCESS_KEY_ID=

# =============================================================================
# 💳 PAYMENT PROCESSING (Stripe)
# =============================================================================
# Stripe test keys for development
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# =============================================================================
# 📧 EMAIL CONFIGURATION
# =============================================================================

# SMTP Email Service (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Note: For Gmail, generate an "App Password" at https://myaccount.google.com/apppasswords

APP_NAME=SimsBuddy
FRONTEND_URL=http://localhost:5173

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com

# =============================================================================
# 🌐 FRONTEND CONFIGURATION (simsbuddy-ssr — Next.js)
# =============================================================================
# URLs: compose sets defaults, override here if you run on non-standard hosts
# Client bundle (browser) points at the host:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Next.js SSR (server-side) points at Docker-internal DNS:
# NEXT_PUBLIC_SERVER_API_BASE_URL=http://backend:3000
# Canonical URL for SEO/metadata:
# NEXT_PUBLIC_BASE_URL=http://localhost:5173

# Google OAuth (optional in dev — leave blank to disable Google sign-in)
# Get from: Google Cloud Console → Credentials → OAuth 2.0 Client IDs
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# =============================================================================
# 📨 EMAILJS (Client-side email sending)
# =============================================================================
# Get from: https://dashboard.emailjs.com/admin
NEXT_PUBLIC_EMAIL_JS_PUBLIC_KEY=YOUR_PUBLIC_KEY
NEXT_PUBLIC_EMAIL_JS_SERVICE_ID=service_YOUR_SERVICE_ID
NEXT_PUBLIC_EMAIL_JS_TEMPLATE_ID=template_YOUR_TEMPLATE_ID
NEXT_PUBLIC_EMAIL_JS_CONTACT_US_TEMPLATE_ID=template_YOUR_CONTACT_TEMPLATE_ID

# =============================================================================
# 📊 OBSERVABILITY (Optional — providers no-op if blank)
# =============================================================================
# PostHog analytics — https://posthog.com/
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry error reporting — https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN=

# =============================================================================
# 🔧 DEVELOPMENT/STAGING SETTINGS
# =============================================================================
# Environment mode
NODE_ENV=staging

# Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=console

# =============================================================================
# 📝 NOTES & TIPS
# =============================================================================
#
# 1. REQUIRED vs OPTIONAL:
#    - Required: DATABASE_URL, LIVEKIT_*, GROQ_API_KEY, ASSEMBLY_API_KEY,
#                INWORLD_API_KEY, OPENAI_API_KEY, STRIPE_*, EmailJS, Google OAuth
#    - Optional: Other AI providers, Google Cloud, AWS
#
# 2. SECURITY:
#    - NEVER commit this .env file to Git
#    - Keep .env in .gitignore
#    - Use different keys for staging/production
#    - Rotate keys regularly
#
# 3. GETTING API KEYS:
#    - Most services offer free tiers or trials
#    - Ask your team lead for shared development keys
#    - Keep track of usage limits
#
# 4. TESTING:
#    - After filling this out, run: ./start-staging.sh
#    - Check logs/staging_*.log for any missing variables
#    - Services will warn about optional missing keys
#
# 5. HELP:
#    - See QUICKSTART.md for setup instructions
#    - See README.md for detailed documentation
#    - Contact team lead if you need credentials
#
# =============================================================================
